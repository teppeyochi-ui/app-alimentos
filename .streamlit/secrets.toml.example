# Copie para .streamlit/secrets.toml (uso local) ou cole em
# Streamlit Community Cloud > seu app > Settings > Secrets.
# NUNCA envie o secrets.toml de verdade para o GitHub.

# Banco PostgreSQL (Supabase > Connect > Session pooler). Sem esta linha,
# o app usa um arquivo SQLite local, que some quando o servidor reinicia.
DATABASE_URL = "postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require"

# PINs de acesso (use números diferentes, de 6 dígitos ou mais)
PIN_OPERADOR = "111111"   # Lançar e Registros
PIN_CONSULTA = "222222"   # Indicadores e Registros (somente leitura)
PIN_GESTOR   = "999999"   # tudo, inclusive Cadastros e exclusão
