# Copie para .streamlit/secrets.toml (local) ou cole em
# Streamlit Cloud > App settings > Secrets.

# Banco de dados central (PostgreSQL). Sem esta linha, usa SQLite local (producao.db).
DATABASE_URL = "postgresql+psycopg2://usuario:senha@host:5432/producao"

# PIN exigido para abrir o app (opcional, recomendado ao publicar na internet).
APP_PIN = "1234"
